/target/
/amatl.toml
# Operator-defined ranking rules (Optics engine). Personal config, same
# treatment as amatl.toml — can encode which sites/topics the operator
# boosts or buries.
*.optic
/amatl.sqlite3*
# Covers every backup AMATL's own storage module produces next to the live
# DB — auto (`.backup-`), migration (`.migration-`) and pre-restore
# (`.pre-restore-`) — none of which match the literal prefix above, and all
# of which can carry the operator's real search history/saved documents.
/amatl*.sqlite3*
# AUDIT-02: server integration runs can create their state database below a
# crate directory. Keep every AMATL SQLite database and its backups local.
**/amatl*.sqlite3*
# AUDIT-03: runtime logs are local operational output, never source material.
*.log
**/*.cdx.json
**/*.cdx.xml
/.env
/.claude/
/.opencode/
*.pem
*.key
*~
# Stray files and transient outputs
0:
*.docx
AMATL_documentado.docx
amatl.backup-*.sqlite3
amatl.log
amatl_logo.png~
# AUDIT-05: browser-audit screenshots (Playwright WebDriver captures) are local
# evidence, regenerated on demand and never source material — same treatment as
# the runtime logs above.
/output/
# AUDIT-04: Python bytecode is a build artifact, never source material.
**/__pycache__/
*.py[co]
# A third-party website template dump, unrelated to AMATL and never source
# material; kept out of history the same way the transient outputs above are.
/analiza/
# Playwright MCP session scratch: local browser-automation state, regenerated on
# demand and never source material.
/.playwright-mcp/
